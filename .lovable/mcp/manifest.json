{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "tokenbel-mcp",
      "version": "0.1.0",
      "title": "TokenBel MCP"
    },
    "tools": [
      {
        "name": "get_site_info",
        "title": "Get TokenBel site info",
        "description": "Return basic information about TokenBel: description, main sections, and key external URLs (dashboard, API, wiki).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "search_securities",
        "title": "Search Belarusian securities",
        "description": "Search Belarusian tokens, shares and bonds by ticker or issuer name via the TokenBel public Hype API.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Ticker fragment or issuer name to search for."
            },
            "limit": {
              "default": 10,
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Maximum number of results to return (1-50)."
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
